<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XzoundWave</AssemblyName>
    <RootNamespace>MRAudioKit</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- EXPLICIT. Without it the SDK self-contains the publish and fails NETSDK1150. -->
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- One file. Everything the tool needs is either a managed assembly folded in
         here, or an embedded resource written out on first use. The .NET runtime is
         the single exception and is the user's to install: bundling it would quadruple
         the download for something most machines already have. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not EnableCompressionInSingleFile: the SDK only allows it for self-contained
         builds, and bundling the runtime is exactly what we are not doing. The largest
         payload, vgmstream, is an already-compressed zip either way. -->
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Run on a newer major runtime rather than refusing to start on .NET 11. -->
    <RollForward>LatestMajor</RollForward>

    <Version>1.0.0</Version>
    <Product>XzoundWave</Product>
    <Authors>Nikolas Becic</Authors>
    <Company>Nikolas Becic</Company>
    <Copyright>Copyright (c) 2026 Nikolas Becic</Copyright>
    <Description>Marvel Rivals sound toolkit — browse, preview, tag and re-pack Wwise soundbanks.</Description>
    <RepositoryUrl>https://github.com/X-zant/XzoundWave-Rivals-Sound-Toolkit</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- CUE4Parse straight from NuGet: no path into any other checkout, so this
         builds anywhere with `dotnet build`, and upstream fixes arrive by bumping
         one version number. -->
    <PackageReference Include="CUE4Parse" Version="1.2.2.202609" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!-- Pulled in transitively by CUE4Parse at 9.0.0, which carries a high-severity
         advisory (GHSA-73j8-2gch-69rq). Pinned forward here; drop this line once
         CUE4Parse itself moves past it. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The encoder is its own assembly so other tools can use it without taking
         a dependency on this app. -->
    <ProjectReference Include="XzoundCore\XzoundCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied beside the exe: the release IS one file, and a
         licence notice cannot travel with a distribution it is not inside. Both are
         readable via the licences verb and written out beside the unpacked vgmstream. -->
    <EmbeddedResource Include="LICENSE" LogicalName="XzoundWave.LICENSE" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md" LogicalName="XzoundWave.THIRD-PARTY-NOTICES.md" />
    <!-- vgmstream-cli and the codec DLLs it loads, unpacked to app data on first use.
         Trimmed from the official win64 zip: the Winamp and XMPlay plugins are 4.3 MB
         the CLI does not need. -->
    <EmbeddedResource Include="vendor/vgmstream-cli-win64.zip" LogicalName="XzoundWave.vgmstream.zip" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library lives in a subfolder, and this project's default glob would
         otherwise compile its sources (and its obj/) a second time, into this
         assembly as well. -->
    <Compile Remove="XzoundCore\**" />
    <EmbeddedResource Remove="XzoundCore\**" />
    <None Remove="XzoundCore\**" />
  </ItemGroup>

</Project>
