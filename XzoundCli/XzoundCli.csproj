<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine with no window on top.

       This exists to be the thing that cannot cheat. It targets net10.0 and references
       nothing but XzoundLogic, so if a verb ever grows a dependency on a window again
       this project stops building — which is a better alarm than noticing on the day
       someone tries the Linux build. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>xzoundwave</AssemblyName>
    <RootNamespace>MRAudioKit</RootNamespace>
    <!-- Windows carries ICU in the operating system, so the Windows build keeps full
         globalization and a reader in a German locale goes on seeing German numbers.
         Linux does not reliably have it, and a self-contained .NET app without ICU
         fails before Main rather than falling back, which would break "nothing to
         install" for the one platform that needed it. See the Linux half below.

         Bundling ICU would cost about 30 MB against a 52 MB binary, so the cheaper
         half of the trade was measured first: with globalization off the Chinese
         category table comes out byte-identical, every self-test passes, and no list
         changes order, because this code sorts with explicit ordinal comparers rather
         than the current culture. What Linux loses is locale-styled numbers. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RollForward>LatestMajor</RollForward>

    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <Version>1.1.2</Version>
    <Product>XzoundWave</Product>
    <Authors>Nikolas Becic</Authors>
    <Company>Nikolas Becic</Company>
    <Copyright>Copyright (c) 2026 Nikolas Becic</Copyright>
    <Description>XzoundWave without a window: every verb, on any platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XzoundLogic\XzoundLogic.csproj" />
  </ItemGroup>

  <!-- The Linux half of the note above. Conditioned on the runtime identifier rather
       than on the target framework, because both builds are the same net10.0. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The same as the window's: the distributable is the one executable. UAssetTool is an Exe
       reached through XzoundLogic, so a publish for a runtime builds it twice, once for that
       runtime and once for none, and the two runtimeconfigs of the same name stopped this
       publish outright (NETSDK1152). Neither it nor UAssetTool's launcher is used: this host
       calls UAssetTool as a library. -->
  <Target Name="PublishOnlyTheExe" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'UAssetTool.runtimeconfig.json'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(RelativePath)' == 'UAssetTool.exe' Or '%(RelativePath)' == 'UAssetTool'" />
    </ItemGroup>
  </Target>

</Project>
