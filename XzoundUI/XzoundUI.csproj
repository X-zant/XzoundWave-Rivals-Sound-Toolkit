<Project Sdk="Microsoft.NET.Sdk">

  <!-- The window, second attempt.

       Avalonia rather than WPF because it is the same model without the Windows
       ceiling: XAML, styles, data templates, bindings. That matters because the point
       is one application for both platforms rather than two that drift.

       A reference to XzoundLogic and nothing else, and the compiler is what keeps that
       true.

       Two target frameworks, matching XzoundLogic's own pair. net10.0 is the portable
       one and the one Linux publishes; net10.0-windows exists so the Windows build of
       the window links the Windows build of the engine and can therefore reach the code
       behind #if WINDOWS. That is not a detail. Built as net10.0 alone, the window took
       the non-Windows branch of every one of those on Windows, so it had no playback
       device at all and told its reader that PipeWire, PulseAudio and ALSA were missing
       while NAudio's WaveOut sat in the engine unreachable. Avalonia itself does not
       care which moniker it is built for and all six of its packages resolve for either;
       the suffix buys the platform-specific half of XzoundLogic and nothing else. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XzoundWave</AssemblyName>
    <RootNamespace>MRAudioKit.UI</RootNamespace>
    <!-- Windows carries ICU in the operating system, so the Windows build keeps full
         globalization and a reader in a German locale goes on seeing German numbers.
         Linux does not reliably have it, and a self-contained .NET app without ICU
         fails before Main rather than falling back, which would break "nothing to
         install" for the one platform that needed it. See the Linux half below.

         Bundling ICU would cost about 30 MB against a 52 MB binary, so the cheaper
         half of the trade was measured first: with globalization off the Chinese
         category table comes out byte-identical, every self-test passes, and no list
         changes order, because this code sorts with explicit ordinal comparers rather
         than the current culture. What Linux loses is locale-styled numbers. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RollForward>LatestMajor</RollForward>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <Version>1.0.0</Version>
    <Product>XzoundWave</Product>
    <Authors>Nikolas Becic</Authors>
    <Company>Nikolas Becic</Company>
    <Copyright>Copyright (c) 2026 Nikolas Becic</Copyright>
    <Description>Marvel Rivals sound toolkit — browse, preview, tag and re-pack Wwise soundbanks.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Renders a window to a bitmap with no screen attached, which is how the layout
         can be looked at on a build machine and checked by a test rather than by
         someone remembering to open the app. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XzoundLogic\XzoundLogic.csproj" />
  </ItemGroup>

  <!-- The Linux half of the note above. Conditioned on the runtime identifier rather
       than on the target framework, because what decides this is the operating system
       the published binary will run on, and the runtime identifier is what names that:
       net10.0 is the portable moniker and can be published for Windows too. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
