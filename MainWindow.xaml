<Window x:Class="MRAudioKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MRAudioKit" Height="780" Width="1360"
        Background="{StaticResource Bg}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- settings -->
        <Expander x:Name="SettingsPanel" Grid.Row="0" IsExpanded="True" Foreground="{StaticResource Fg}"
                  Header="Setup  (nothing here ships with the tool — supply your own)">
            <Grid Margin="4,8,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Paks folder"/>
                <TextBox x:Name="TbPaks" Grid.Row="0" Grid.Column="1" Margin="0,0,8,4"/>
                <Label Grid.Row="0" Grid.Column="3" Content="AES key"/>
                <TextBox x:Name="TbAes" Grid.Row="0" Grid.Column="4" Margin="0,0,0,4"/>

                <Label Grid.Row="1" Grid.Column="0" Content="usmap"/>
                <TextBox x:Name="TbUsmap" Grid.Row="1" Grid.Column="1" Margin="0,0,8,4"/>
                <Label Grid.Row="1" Grid.Column="3" Content="vgmstream-cli.exe"/>
                <TextBox x:Name="TbVgm" Grid.Row="1" Grid.Column="4" Margin="0,0,0,4"/>

                <Label Grid.Row="2" Grid.Column="0" Content="WwiseConsole.exe"/>
                <TextBox x:Name="TbWwiseConsole" Grid.Row="2" Grid.Column="1" Margin="0,0,8,4"/>
                <Label Grid.Row="2" Grid.Column="3" Content="Wwise .wproj"/>
                <TextBox x:Name="TbWwiseProj" Grid.Row="2" Grid.Column="4" Margin="0,0,0,4"/>

                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                            Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnLoad" Content="Load game" Click="BtnLoad_Click"/>
                    <Label Content="Language" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbLang" Width="140" Margin="0,0,12,0"/>
                    <TextBlock Text="AES key and usmap are per-patch and user-supplied. Wwise is optional — only needed to generate Vorbis test clips."
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="BtnPlay" Content="▶  Play" Click="BtnPlay_Click"/>
            <Button x:Name="BtnStop" Content="■  Stop" Click="BtnStop_Click"/>
            <Button x:Name="BtnDur" Content="Measure durations" Click="BtnDur_Click"/>
            <Button x:Name="BtnWav" Content="Export WAV" Click="BtnWav_Click"/>
            <Button x:Name="BtnWem" Content="Export WEM" Click="BtnWem_Click"/>
            <Button x:Name="BtnCell" Content="Copy sheet cell" Click="BtnCell_Click"/>
            <Button x:Name="BtnCsv" Content="Export CSV" Click="BtnCsv_Click"/>
            <Separator Margin="8,0"/>
            <Button x:Name="BtnReplace" Content="Set replacement…" Click="BtnReplace_Click"/>
            <Button x:Name="BtnClear" Content="Clear" Click="BtnClear_Click"/>
            <Button x:Name="BtnBuild" Content="Build modded .bnk" Click="BtnBuild_Click"
                    FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <Button x:Name="BtnTestBank" Content="Numbered test bank…" Click="BtnTestBank_Click"
                    ToolTip="Replace every sound in the selected bank(s) with a clip that speaks a number, and write a legend so you can identify what you hear in game."/>
            <Separator Margin="8,0"/>
            <Label Content="Filter" VerticalAlignment="Center"/>
            <TextBox x:Name="TbFilter" Width="260" TextChanged="TbFilter_TextChanged"/>
            <CheckBox x:Name="CbUnnamed" Content="show unnamed" Margin="12,0,0,0"
                      Click="TbFilter_TextChanged"/>
            <CheckBox x:Name="CbPerBank" Content="number per bank" Margin="12,0,0,0" IsChecked="True"
                      ToolTip="Restart the numbering at the start value for each bank, instead of continuing the count across all of them."/>
            <CheckBox x:Name="CbPrefetch" Content="prefetch mode" Margin="12,0,0,0"
                      ToolTip="OFF (normal): the whole clip goes into the .bnk and nothing ships under Media/.&#10;ON: the bank keeps each sound's vanilla opening fragment and the full clip ships as a loose Media/ file."/>
        </StackPanel>

        <!-- body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="470"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Tree" Grid.Column="0"
                      Background="{StaticResource Bg2}" Foreground="{StaticResource Fg}"
                      BorderBrush="{StaticResource Line}"
                      SelectedItemChanged="Tree_SelectedItemChanged"/>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Line}"/>

            <DataGrid x:Name="Grid_" Grid.Column="2" AutoGenerateColumns="False"
                      SelectionMode="Single" CellEditEnding="Grid_CellEditEnding"
                      Background="{StaticResource Bg2}" Foreground="{StaticResource Fg}"
                      RowBackground="{StaticResource Bg2}" AlternatingRowBackground="#26282B"
                      BorderBrush="{StaticResource Line}" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Line}"
                      MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mod"      Binding="{Binding Mod}"      Width="70"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Bank"     Binding="{Binding Bank}"     Width="175" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Event"    Binding="{Binding Display}"  Width="280" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Media ID" Binding="{Binding MediaId}"  Width="95"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Len"      Binding="{Binding Length}"   Width="55"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Codec"    Binding="{Binding Codec}"    Width="75"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="95" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Subtitle / line" Binding="{Binding Subtitle}" Width="*" IsReadOnly="True"/>
                    <!-- the only editable columns: free text, saved to notes.json -->
                    <DataGridTextColumn Header="Notes"       Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                        Width="200"/>
                    <DataGridTextColumn Header="Extra notes" Binding="{Binding ExtraNotes, UpdateSourceTrigger=PropertyChanged}"
                                        Width="200"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Line}"/>

            <!-- staged replacements: drop .wem files here, named {MediaID}-{note}.wem -->
            <Border x:Name="DropPane" Grid.Column="4" AllowDrop="True"
                    Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" Drop="DropPane_Drop" DragOver="DropPane_DragOver"
                    DragLeave="DropPane_DragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="10,8,10,6">
                        <TextBlock Text="Custom .wem files" FontWeight="Bold"/>
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Drag files or folders here — batches welcome."/>
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Name them  {MediaID}-{your note}.wem  — everything after the first hyphen is yours to use as a reminder and is ignored when assigning."/>
                    </StackPanel>

                    <DataGrid x:Name="PendingGrid" Grid.Row="1" Margin="6,0,6,0"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                              Background="{StaticResource Bg2}" Foreground="{StaticResource Fg}"
                              RowBackground="{StaticResource Bg2}" AlternatingRowBackground="#26282B"
                              BorderBrush="{StaticResource Line}" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Line}"
                              HeadersVisibility="Column">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Tip}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Media ID"  Binding="{Binding MediaId}" Width="88"/>
                            <DataGridTextColumn Header="Your note" Binding="{Binding Note}"    Width="*"/>
                            <DataGridTextColumn Header="Replaces"  Binding="{Binding Original}" Width="*"/>
                            <DataGridTextColumn Header="Lands in"  Binding="{Binding Status}"  Width="165"/>
                            <DataGridTextColumn Header="Codec"     Binding="{Binding Codec}"   Width="66"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,8,8,8">
                        <Button Content="Add files…" Click="BtnAddFiles_Click"/>
                        <Button Content="Remove" Click="BtnRemovePending_Click"/>
                        <Button Content="Clear all" Click="BtnClear_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="3" Margin="2,8,0,0"
                   Foreground="{StaticResource Muted}" Text="Fill in Setup, then Load game."/>
    </Grid>
</Window>
