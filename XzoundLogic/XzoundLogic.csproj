<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that is not a window.

       The split is not cosmetic: this assembly targets net10.0 rather than
       net10.0-windows, so the compiler is what enforces the rule. A System.Windows
       using in here does not build, which is a stronger guarantee than a convention
       about which folder a file lives in.

       The namespace stays MRAudioKit on both sides of the split, so moving a file
       across the boundary changes nothing about how it is referenced. -->

  <PropertyGroup>
    <!-- Two targets on purpose. net10.0 is the real one and the one Linux uses; the
         windows target exists only so the Windows build can keep NAudio's WaveOut and
         Media Foundation, which are packaged for windows TFMs alone. Code that needs
         either sits behind #if WINDOWS, so the portable target cannot accidentally
         grow a dependency on them. Both disappear once PortAudio and vgmstream take
         over playback and decoding. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XzoundLogic</AssemblyName>
    <RootNamespace>MRAudioKit</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.1.0</Version>
    <Product>XzoundWave</Product>
    <Authors>Nikolas Becic</Authors>
    <Company>Nikolas Becic</Company>
    <Copyright>Copyright (c) 2026 Nikolas Becic</Copyright>
    <Description>XzoundWave's engine: paks, soundbanks, building and the headless verbs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202609" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!-- Pulled in transitively by CUE4Parse at 9.0.0, which carries a high-severity
         advisory (GHSA-73j8-2gch-69rq). Pinned forward here; drop this line once
         CUE4Parse itself moves past it. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XzoundCore\XzoundCore.csproj" />
  </ItemGroup>

  <!-- UAssetToolRivals, a git submodule pinned to a commit, for the voice-line builder:
       UAssetAPI edits the game's cooked assets as typed objects (the voice table, the
       VoiceItem, AkAudioEvent through its typed export), and UAssetTool's own mod builder
       turns them into the IoStore bundle the game loads. Referenced as projects rather
       than copied DLLs so one build covers both and the pinned commit says exactly
       which version shipped. A fresh clone needs the submodule initialised before it builds. -->
  <ItemGroup>
    <ProjectReference Include="..\vendor\UAssetToolRivals\src\UAssetAPI\UAssetAPI.csproj" />
    <ProjectReference Include="..\vendor\UAssetToolRivals\src\UAssetTool\UAssetTool.csproj" />
  </ItemGroup>

  <!-- The sample-provider layer NAudio calls Core is netstandard and portable; WaveOut,
       the one Windows output this uses, is not, and is packaged for a windows TFM alone.

       WinMM rather than the NAudio meta-package, which is what this took until the
       window started building for a windows moniker too. The meta-package also brings
       WinForms, Wasapi, Asio, Dmo and Midi, and NAudio.WinForms declares a framework
       reference on Microsoft.WindowsDesktop.App.WindowsForms. A framework reference
       reaches the runtimeconfig of everything downstream, so taking the whole set would
       have made the Avalonia window ask for the .NET Desktop Runtime on Windows, on
       account of six assemblies it never loads, where before it needed only the plain
       one. The Media Foundation readers go with them and are not missed: every
       compressed import has gone through vgmstream since, on all three platforms. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="NAudio.WinMM" Version="3.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <PackageReference Include="NAudio.Core" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- These live with the code that reads them: Bundled and the licences verb both
         resolve resources through typeof(X).Assembly, so a resource has to be in the
         same assembly as its reader. The paths point back up at the repo root because
         the files themselves are the repo's, not this project's. -->
    <EmbeddedResource Include="..\LICENSE" LogicalName="XzoundWave.LICENSE" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.md" LogicalName="XzoundWave.THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <!-- Thirty spoken words, recorded once on Windows by the numberclips verb, from which any
       number up to four digits is composed. They are embedded rather than generated on
       demand because the recorder is a Windows speech voice and the numbered test banks
       are wanted on every platform: without these, a Linux build cannot say "42" at all.

       The LogicalName has to match NumberSpeech.ResourceName, hence %(Filename). -->
  <ItemGroup>
    <EmbeddedResource Include="..\assets\numberwords\*.wav"
                      LogicalName="XzoundWave.numbers.%(Filename).wav" />
  </ItemGroup>

  <!-- vgmstream, unpacked to app data on first use. Only the payload for what is
       being built is carried: a Windows release has no reason to hold a Linux binary.
       With no runtime identifier, which is what a plain dotnet build gives, both
       conditions hold and both go in, so a development build can run either way.

       The Windows payload is the official win64 zip trimmed of the Winamp and XMPlay
       plugins, 4.3 MB the CLI does not need. The Linux one is a single static binary
       and needs no trimming or codec libraries beside it. -->
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('linux'))">
    <EmbeddedResource Include="..\vendor\vgmstream-cli-win64.zip"
                      LogicalName="XzoundWave.vgmstream.windows.zip" />
  </ItemGroup>
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('win'))">
    <EmbeddedResource Include="..\vendor\vgmstream-cli-linux64.zip"
                      LogicalName="XzoundWave.vgmstream.linux.zip" />
  </ItemGroup>

</Project>
